# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# env files and secrets (never commit; .env.example is the only exception)
.env*
!.env.example
*.pem
*.key

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Claude Code local settings
.claude/settings.local.json

# Client source material (kept locally, not part of the site)
# Raw Dropbox photo download (~1.2 GB); the web-sized picks are exported to public/images
# by scripts/export-photos.mjs and ARE committed.
/photos
# Saved copy of the WebRezPro booking page, used once to collect cabin details.
/webrez-export

# Archives
*.zip
